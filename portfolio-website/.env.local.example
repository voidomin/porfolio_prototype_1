# Copy this file to .env.local and fill in your values
NEXT_PUBLIC_SITE_URL=https://akashportfolio.dev

# Set to "true" to enable the admin panel (leave unset in production)
ENABLE_ADMIN=true

# Required for the contact form (src/app/api/contact/route.ts) to actually send email
RESEND_API_KEY=

# Required for the admin CMS's AI photo-caption feature (src/app/api/admin/caption/route.ts)
# Only needed if ENABLE_ADMIN=true and you use that feature
GEMINI_API_KEY=

# Optional — powers the GitHub activity trail in the About section
# (src/app/api/github-activity/route.ts). GitHub's contribution-calendar data
# isn't exposed by the plain REST API, only GraphQL, which requires a token
# even for your own public data. A classic personal access token with no
# special scopes is enough. Left unset, the trail simply doesn't render.
GITHUB_TOKEN=
